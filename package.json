{
  "name": "local-file-converter",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && node scripts/generate-media.cjs && playwright test",
    "test:live": "playwright test -c playwright.live.config.cjs",
    "build": "node scripts/check-vendor.cjs && node scripts/build.cjs",
    "check": "node --check app.js && node --check runtime.js",
    "vendor:check": "node scripts/check-vendor.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
